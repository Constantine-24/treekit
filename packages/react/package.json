{
  "name": "@constantine-24/treekit-react",
  "version": "0.1.0",
  "description": "React component over @constantine-24/treekit-core: virtualized tree with native HTML5 drag-and-drop, keyboard-accessible DnD, multi-select, filtering, and lazy loading.",
  "license": "MIT",
  "author": "Konstantin Penzin",
  "homepage": "https://constantine-24.github.io/treekit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine-24/treekit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Constantine-24/treekit/issues"
  },
  "keywords": [
    "react",
    "tree",
    "treeview",
    "tree-view",
    "drag-and-drop",
    "dnd",
    "virtualized",
    "virtual-scroll",
    "keyboard",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@constantine-24/treekit-core": "workspace:0.x",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@constantine-24/treekit-core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "jsdom": "^26.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
