{
  "name": "@treekit/core",
  "version": "0.0.0",
  "description": "Headless virtualized tree engine with native HTML5 drag-and-drop: tree state, virtualization, DnD, keyboard accessibility. Zero dependencies.",
  "license": "MIT",
  "author": "Konstantin Penzin",
  "homepage": "https://constantine-24.github.io/treekit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine-24/treekit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Constantine-24/treekit/issues"
  },
  "keywords": [
    "tree",
    "treeview",
    "drag-and-drop",
    "dnd",
    "virtualized",
    "virtual-scroll",
    "headless",
    "accessibility",
    "framework-agnostic",
    "react",
    "angular",
    "vanilla",
    "tree-view"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "import": "./dist/tanstack.js",
      "require": "./dist/tanstack.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/virtual-core": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/virtual-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tanstack/virtual-core": "^3.13.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
