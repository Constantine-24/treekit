{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    /*
     * Source-linked, like demo-angular: Vite aliases these to the package sources
     * too (vite.config.ts), so library edits hot-reload with no rebuild. See
     * apps/CLAUDE.md for the staleness trap this avoids.
     */
    "paths": {
      "@constantine-24/treekit-core": ["../../packages/core/src/index.ts"],
      "@constantine-24/treekit-core/tanstack": ["../../packages/core/src/tanstack.ts"],
      "@constantine-24/treekit-react": ["../../packages/react/src/index.ts"],
      "demo-shared": ["../demo-shared/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
